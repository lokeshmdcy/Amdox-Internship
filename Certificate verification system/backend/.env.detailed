# ================================================
# Certificate Verification System
# Backend Environment Configuration
# ================================================

# --------------------------------------------
# Server Configuration
# --------------------------------------------

# The port on which the backend server will run
# Default: 5000
# Make sure this port is not used by another application
PORT=5000

# Node environment (development, production, test)
# In development: detailed error messages
# In production: minimal error messages for security
NODE_ENV=development

# --------------------------------------------
# Database Configuration
# --------------------------------------------

# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/database_name
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database_name

# Local MongoDB (Default - works out of the box):
MONGODB_URI=mongodb://localhost:27017/certificate_verification

# MongoDB Atlas Example (Cloud Database):
# MONGODB_URI=mongodb+srv://admin:yourpassword@cluster0.xxxxx.mongodb.net/certificate_verification?retryWrites=true&w=majority

# Note: Replace with your actual MongoDB Atlas connection string for production

# --------------------------------------------
# Security Configuration
# --------------------------------------------

# JWT (JSON Web Token) Secret Key
# IMPORTANT: Change this to a long, random string in production!
# Generate a secure key: https://randomkeygen.com/
# Current key is for DEVELOPMENT ONLY
JWT_SECRET=certificate_verification_secret_key_change_in_production_2024

# Recommended for production: Minimum 32 characters, mix of letters, numbers, symbols
# Example: JWT_SECRET=9k#mP2$vX8@qL5&nR7!wS4*jH6^tY3+bN1

# --------------------------------------------
# Admin Account Configuration
# --------------------------------------------

# Default admin credentials
# These are used when creating the initial admin user
# IMPORTANT: Change these in production!

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Production recommendation:
# ADMIN_EMAIL=your-real-email@yourdomain.com
# ADMIN_PASSWORD=YourStrongPasswordHere123!@#

# --------------------------------------------
# Frontend Configuration
# --------------------------------------------

# Frontend URL for CORS (Cross-Origin Resource Sharing)
# This allows the frontend to communicate with the backend
# For development:
FRONTEND_URL=http://localhost:3000

# For production (replace with your actual frontend URL):
# FRONTEND_URL=https://your-frontend-domain.com

# --------------------------------------------
# Optional: Email Configuration (for future use)
# --------------------------------------------

# Uncomment and configure if you want to send emails
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-specific-password
# EMAIL_FROM=Certificate System <noreply@yourdomain.com>

# --------------------------------------------
# Optional: File Upload Configuration
# --------------------------------------------

# Maximum file upload size (in bytes)
# Default: 5MB (5 * 1024 * 1024 = 5242880 bytes)
# MAX_FILE_SIZE=5242880

# Allowed file types for upload
# ALLOWED_FILE_TYPES=.xlsx,.xls

# --------------------------------------------
# Optional: Rate Limiting
# --------------------------------------------

# Maximum requests per IP per time window
# Default: 100 requests per 15 minutes
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# --------------------------------------------
# Production Checklist (BEFORE DEPLOYMENT!)
# --------------------------------------------

# [ ] Change JWT_SECRET to a strong random string
# [ ] Update ADMIN_EMAIL and ADMIN_PASSWORD
# [ ] Set NODE_ENV to 'production'
# [ ] Update MONGODB_URI to production database
# [ ] Update FRONTEND_URL to production frontend URL
# [ ] Enable HTTPS
# [ ] Configure email settings (if using)
# [ ] Review and adjust rate limiting
# [ ] Set up database backups
# [ ] Configure logging
# [ ] Set up monitoring

# --------------------------------------------
# Important Notes
# --------------------------------------------

# 1. NEVER commit .env file to version control (Git)
#    It's already in .gitignore
#
# 2. Keep .env.example for reference but without sensitive data
#
# 3. Each environment (dev, staging, production) should have its own .env
#
# 4. Use environment variables on hosting platforms:
#    - Heroku: Config Vars
#    - Vercel: Environment Variables
#    - DigitalOcean: App Platform Environment Variables
#
# 5. For MongoDB Atlas:
#    - Create a cluster at https://cloud.mongodb.com
#    - Whitelist your IP address
#    - Create a database user
#    - Get connection string from "Connect" button

# --------------------------------------------
# Testing Configuration
# --------------------------------------------

# Use this connection string for testing (optional)
# TEST_MONGODB_URI=mongodb://localhost:27017/certificate_verification_test

# ================================================
# End of Configuration
# ================================================
